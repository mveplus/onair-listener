{
  "manifest_version": 3,
  "name": "ON-AIR Meeting Trigger",
  "version": "1.2.0",
  "description": "Detects Meet/Zoom/Teams tabs and triggers a local listener and/or an ON-AIR LED sign on your LAN.",
  "action": {
    "default_title": "ON-AIR",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
